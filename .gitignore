# Packages installed by npm; recreated with npm ci.
node_modules/

# Generated app files, test coverage, and TypeScript build information.
.next/
out/
coverage/
*.tsbuildinfo

# Private credentials. Only the empty template belongs in Git.
.env*
!.env.example

# macOS folder metadata.
.DS_Store

# Private UI captures and browser authentication state.
/screenshots/
/screenshots-tool/.auth/
/screenshots-tool/.artifacts/

# Local brokerage exports and import working files; never serve from public/.
/private-data/
# Protect CSV exports even when accidentally placed elsewhere in this project.
*.[cC][sS][vV]

# Local diagnostics, logs, databases, and tooling state.
*.log
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
*.pem
*.key
/local-audits/
/playwright-report/
/test-results/

# Source-only distribution/review archives; never commit generated releases.
/releases/
