# Required for live mode: your own SnapTrade Personal API credentials only.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Optional publishable pk_ key. Empty disables third-party logo requests.
LOGO_DEV_PUBLISHABLE_KEY=

# Optional true/false. Empty defaults to false; true uses fictional data only.
HOLDINGS_DEMO_MODE=

# Optional reported or USD. Empty defaults to reported; USD relabels without FX.
HOLDINGS_OPTIONS_CURRENCY=

# Optional true/false. Empty defaults to false; HYSA is only a personal label.
HOLDINGS_CASH_ONLY_AS_HYSA=
